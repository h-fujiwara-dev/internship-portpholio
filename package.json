{
  "name": "internship-portfolio",
  "version": "0.3.1",
  "private": true,
  "description": "AI coding agent-built pixel-perfect clone of a Japanese internship listing site, de-branded as a portfolio piece",
  "author": "h-fujiwara-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/h-fujiwara-dev/internship-portpholio.git"
  },
  "homepage": "https://github.com/h-fujiwara-dev/internship-portpholio#readme",
  "bugs": {
    "url": "https://github.com/h-fujiwara-dev/internship-portpholio/issues"
  },
  "keywords": [
    "claude-code",
    "portfolio",
    "nextjs",
    "ai",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
